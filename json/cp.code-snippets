      "template <class T, class F>",
      "struct SegTree {",
      "    int n;",
      "    vector<T> seg, lazy;",
      "    T ID;      // identity element (e.g. 0 for sum, -INF for max)",
      "    F op;      // associative function (sum, max, min, ...)",
      "",
      "    SegTree(int n, T id, F f) : n(n), ID(id), op(f) {",
      "        seg.assign(4*n, ID);",
      "        lazy.assign(4*n, 0);",
      "    }",
      "",
      "    SegTree(const vector<T>& a, T id, F f) : n((int)a.size()), ID(id), op(f) {",
      "        seg.assign(4*n, ID);",
      "        lazy.assign(4*n, 0);",
      "        build(0, 0, n-1, a);",
      "    }",
      "",
      "    void build(int i, int l, int r, const vector<T>& a) {",
      "        if (l == r) {",
      "            seg[i] = a[l];",
      "            return;",
      "        }",
      "        int m = (l + r) / 2;",
      "        build(2*i+1, l, m, a);",
      "        build(2*i+2, m+1, r, a);",
      "        seg[i] = op(seg[2*i+1], seg[2*i+2]);",
      "    }",
      "",
      "    void apply(int i, int l, int r, T val) {",
      "        seg[i] += val * (r - l + 1); // adjust for max/min trees if needed",
      "        lazy[i] += val;",
      "    }",
      "",
      "    void push(int i, int l, int r) {",
      "        if (lazy[i] != 0 && l != r) {",
      "            int m = (l + r) / 2;",
      "            apply(2*i+1, l, m, lazy[i]);",
      "            apply(2*i+2, m+1, r, lazy[i]);",
      "            lazy[i] = 0;",
      "        }",
      "    }",
      "",
      "    void update(int i, int l, int r, int ql, int qr, T val) {",
      "        if (qr < l || r < ql) return;",
      "        if (ql <= l && r <= qr) {",
      "            apply(i, l, r, val);",
      "            return;",
      "        }",
      "        push(i, l, r);",
      "        int m = (l + r) / 2;",
      "        update(2*i+1, l, m, ql, qr, val);",
      "        update(2*i+2, m+1, r, ql, qr, val);",
      "        seg[i] = op(seg[2*i+1], seg[2*i+2]);",
      "    }",
      "",
      "    T query(int i, int l, int r, int ql, int qr) {",
      "        if (qr < l || r < ql) return ID;",
      "        if (ql <= l && r <= qr) return seg[i];",
      "        push(i, l, r);",
      "        int m = (l + r) / 2;",
      "        return op(query(2*i+1, l, m, ql, qr),",
      "                  query(2*i+2, m+1, r, ql, qr));",
      "    }",
      "",
      "    void update(int l, int r, T val) { update(0, 0, n-1, l, r, val); }",
      "    T query(int l, int r) { return query(0, 0, n-1, l, r); }",
