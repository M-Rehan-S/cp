      "// Extended Euclidean Algorithm for modular inverse",
      "int modInverse(int b, int M) {",
      "    int x0 = 1, x1 = 0;",
      "    int a = b, m = M;",
      "    while (m) {",
      "        int q = a / m;",
      "        tie(a, m) = make_tuple(m, a % m);",
      "        tie(x0, x1) = make_tuple(x1, x0 - q * x1);",
      "    }",
      "    if (a != 1) return -1; // inverse doesn't exist (not coprime)",
      "    return (x0 % M + M) % M;",
      "}",
      "",
      "// Modular division: (a / b) % M",
      "int modDivide(int a, int b, int M) {",
      "    a %= M;",
      "    b %= M;",
      "    int inv = modInverse(b, M);",
      "    if (inv == -1)",
      "        return -1; // return -1 if inverse doesn't exist",
      "    return (__int128)a * inv % M; // prevent overflow safely",
      "}"
