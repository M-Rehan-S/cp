  "Polynomial Hashing with update": {
    "prefix": "polynomialhashing",
    "body": [
      "typedef unsigned long long ull;",
      "",
      "/*",
      " * Polynomial hash:  H(s) = sum_{i=0}^{n-1} val(s[i]) * B^i   (mod 2^61 - 1)",
      " *",
      " *  - Mod 2^61-1 with a random base -> collision probability ~ n / 2^61, anti-hack safe.",
      " *  - Power of B is indexed by position, so a point update is O(1):",
      " *        newH = H - val(old)*B^idx + val(new)*B^idx",
      " *  - val(c) = c + 1 so no character ever maps to 0.",
      " *",
      " * Max string length: 1e6",
      " */",
      "",
      "const int MAXN = 1000000 + 5;",
      "const ull MOD = (1ULL << 61) - 1;",
      "",
      "static ull BASE;",
      "static ull pw[MAXN];",
      "",
      "static inline ull mulmod(ull a, ull b) {",
      "    __uint128_t t = (__uint128_t)a * b;",
      "    ull r = (ull)(t & MOD) + (ull)(t >> 61);",
      "    if (r >= MOD) r -= MOD;",
      "    return r;",
      "}",
      "",
      "static inline ull addmod(ull a, ull b) {",
      "    ull r = a + b;",
      "    if (r >= MOD) r -= MOD;",
      "    return r;",
      "}",
      "",
      "static inline ull submod(ull a, ull b) {",
      "    return a >= b ? a - b : a + MOD - b;",
      "}",
      "",
      "static inline ull val(char c) { return (ull)(unsigned char)c + 1; }",
      "",
      "// Precompute powers of the base (runs once before main)",
      "struct HashInit {",
      "    HashInit() {",
      "        mt19937_64 rng(chrono::steady_clock::now().time_since_epoch().count());",
      "        BASE = rng() % (MOD - 1000) + 500;  // random base in [500, MOD-500)",
      "        pw[0] = 1;",
      "        for (int i = 1; i < MAXN; i++) pw[i] = mulmod(pw[i - 1], BASE);",
      "    }",
      "} hashInit;",
      "",
      "// 1. Hash of the whole string: O(n)",
      "ull computeHash(const string& s) {",
      "    ull h = 0;",
      "    for (size_t i = 0; i < s.size(); i++)",
      "        h = addmod(h, mulmod(val(s[i]), pw[i]));",
      "    return h;",
      "}",
      "",
      "// 2. Point update: set s[idx] = c, return the new hash: O(1)",
      "//    Also updates s in place so later calls stay consistent.",
      "ull updateHash(string& s, ull h, int idx, char c) {",
      "    h = submod(h, mulmod(val(s[idx]), pw[idx]));  // remove old char",
      "    h = addmod(h, mulmod(val(c), pw[idx]));       // add new char",
      "    s[idx] = c;",
      "    return h;",
      "}"
    ],
    "description": "Polynomial Hashing with update"
  },
